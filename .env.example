APP_NAME="Gambia SchoolOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: sqlite. For XAMPP MySQL, switch to mysql and set credentials.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gbschools
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Prefer Redis in production for cache/session/queue (ADR-003).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Central SaaS hostnames (comma-separated). School subdomains use SCHOOLOS_BASE_DOMAIN.
# Local php artisan serve: keep central as localhost/127.0.0.1; set base to gmschoolos.edu.gm for the register UI suffix.
SCHOOLOS_CENTRAL_DOMAINS=localhost,127.0.0.1
SCHOOLOS_BASE_DOMAIN=gmschoolos.edu.gm
# Production (also set APP_URL=https://gmschoolos.edu.gm and SESSION_DOMAIN=.gmschoolos.edu.gm):
# SCHOOLOS_CENTRAL_DOMAINS=gmschoolos.edu.gm,www.gmschoolos.edu.gm
# Requires SESSION_DOMAIN=.gmschoolos.edu.gm so the login cookie follows the tenant hop.
SCHOOLOS_REDIRECT_TENANT_AFTER_REGISTER=false
# --- Custom domains (schools replacing {slug}.base_domain with their own URL) ---
# Public IPv4 of your edge/load balancer; shown as the A record for bare domains (school.edu.gm).
# SCHOOLOS_CUSTOM_DOMAIN_IP=203.0.113.10
# Optional shared CNAME target (e.g. domains.gmschoolos.edu.gm). When set, schools must also add the TXT ownership record.
# SCHOOLOS_CUSTOM_DOMAIN_CNAME_TARGET=
# Leave unset: DNS is skipped only in local/testing. Set false to always require real DNS.
# SCHOOLOS_CUSTOM_DOMAIN_AUTO_VERIFY=
SCHOOLOS_CUSTOM_DOMAIN_LIMIT=3
SCHOOLOS_CUSTOM_DOMAIN_PENDING_TTL_DAYS=14
# Restrict custom domains to certain plan codes, e.g. standard,premium (empty = all plans).
# SCHOOLOS_CUSTOM_DOMAIN_PLAN_CODES=
# Forward public pages from the platform subdomain to the primary custom domain once HTTPS is active.
SCHOOLOS_REDIRECT_TO_PRIMARY_DOMAIN=true
# On-demand TLS (Caddy `ask`): GET /_internal/domains/allow?domain=host&token=SECRET -> 200 for verified hosts only.
# SCHOOLOS_TLS_ASK_TOKEN=
# Run `php artisan schedule:work` (or cron `schedule:run`) so pending domains are auto-verified every 5 minutes.
SCHOOLOS_TRIAL_DAYS=30
# Annual billing (Phase 2): reminder offsets in days before expiry, billing currency, grace period (0 = suspend at expiry).
# Run the scheduler (cron schedule:run) - schoolos:billing:process runs hourly.
# SCHOOLOS_BILLING_CURRENCY=GMD
# SCHOOLOS_TRIAL_REMINDER_DAYS=14,7,3,1
# SCHOOLOS_PAID_REMINDER_DAYS=30,14,7,3,1
# SCHOOLOS_GRACE_DAYS=0
# Payment methods are listed but not actionable until their Phase 3 workflows exist (leave false).
# SCHOOLOS_PAY_CASH=false
# SCHOOLOS_PAY_WAVE=false
# SCHOOLOS_PAY_BANK=false
# SCHOOLOS_PAY_STRIPE=false
# --- Phase 3 payments (cash/bank default ON; Wave/Stripe default OFF until configured AND switched on) ---
# Never commit real values. Keys live only in the server environment.
# SCHOOLOS_CASH_OFFICE=
# SCHOOLOS_CASH_INSTRUCTIONS=
# SCHOOLOS_OPEN_PAYMENT_TTL_DAYS=30
# SCHOOLOS_VERIFICATION_SLA_DAYS=3
# SCHOOLOS_RECONCILE_AFTER_MINUTES=10
# SCHOOLOS_EVIDENCE_DISK=local
# SCHOOLOS_EVIDENCE_MAX_KB=5120
# Stripe (hosted Checkout). Stripe does not list GMD: set an approved charge currency AND fixed rate, or it stays unavailable.
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# SCHOOLOS_STRIPE_CURRENCY=USD
# SCHOOLOS_STRIPE_FX_RATE=
# Wave (official merchant API). Documented currency is XOF: set an approved rate, or confirm GMD with Wave.
# WAVE_API_KEY=
# WAVE_WEBHOOK_STRATEGY=signing
# WAVE_REQUEST_SIGNING_SECRET=
# WAVE_WEBHOOK_SECRET=
# SCHOOLOS_WAVE_CURRENCY=XOF
# SCHOOLOS_WAVE_FX_RATE=
SCHOOLOS_DEFAULT_LOCALE=en
SCHOOLOS_SMS_DRIVER=log
SCHOOLOS_EXPORT_TTL_HOURS=24

# Marketing / landing contact
SCHOOLOS_CONTACT_EMAIL=info@gmschoolos.edu.gm
SCHOOLOS_DEMO_EMAIL=info@gmschoolos.edu.gm
SCHOOLOS_SUPPORT_EMAIL=info@gmschoolos.edu.gm
SCHOOLOS_CONTACT_PHONE="+220 877031891"
SCHOOLOS_CONTACT_PHONE_2=
SCHOOLOS_CONTACT_ADDRESS="Smartworld, Opposite Netpage, Kairaba Avenue, The Gambia"
SCHOOLOS_CONTACT_WEBSITE=https://gmschoolos.edu.gm
# SCHOOLOS_SOCIAL_FACEBOOK=
# SCHOOLOS_SOCIAL_TWITTER=
# SCHOOLOS_SOCIAL_LINKEDIN=
# SCHOOLOS_SOCIAL_YOUTUBE=
SCHOOLOS_POPULAR_PLAN=standard
# live production counts on the public landing strip
SCHOOLOS_LANDING_STATS_MODE=live

# Phase 5 — scale foundations
SCHOOLOS_QUERY_PROFILE=false
SCHOOLOS_SLOW_QUERY_MS=100
SCHOOLOS_CACHE_PUBLIC_SITE=300
SCHOOLOS_CACHE_ADMIN_DASHBOARD=60
SCHOOLOS_CACHE_PLANS=600
SCHOOLOS_QUEUE_CRITICAL=critical
SCHOOLOS_QUEUE_DEFAULT=default
SCHOOLOS_QUEUE_IMPORTS=imports
SCHOOLOS_QUEUE_EXPORTS=exports
SCHOOLOS_QUEUE_NOTIFICATIONS=notifications
SCHOOLOS_QUEUE_REPORTS=reports
SCHOOLOS_AS_APP_MIN=1
SCHOOLOS_AS_APP_MAX=4
SCHOOLOS_AS_WORKER_MIN=1
SCHOOLOS_AS_WORKER_MAX=6
SCHOOLOS_AS_TARGET_CPU=65
SCHOOLOS_AS_QUEUE_SCALE_OUT=100
SCHOOLOS_DB_CONNECTION_BUDGET=80
SCHOOLOS_COST_DAILY_BUDGET=100000
SCHOOLOS_COST_ALERT_PCT=80
SCHOOLOS_SERVICE_TAG=app
# Phase 11 — /metrics is fail-closed in production. Set a long random token (and/or IP allow-list)
# for autoscaling probes. Header: Authorization: Bearer <token> or X-Metrics-Token.
# SCHOOLOS_METRICS_TOKEN=
# SCHOOLOS_METRICS_ALLOW_IPS=10.0.0.0,127.0.0.1

# Phase 7 — workload modelling inputs (estimates only)
SCHOOLOS_WL_RPS_PER_REPLICA=40
SCHOOLOS_WL_RPS_PER_WORKER=80
SCHOOLOS_WL_DB_CONN_PER_REPLICA=15
SCHOOLOS_WL_A_USERS=5000
SCHOOLOS_WL_B_USERS=25000
SCHOOLOS_WL_C_USERS=100000

# Production hardening — error reporting + security headers
SCHOOLOS_ERRORS_ENABLED=true
SCHOOLOS_ERRORS_LOG_CHANNEL=stack
# SCHOOLOS_ERRORS_WEBHOOK_URL=https://hooks.example.com/schoolos
SCHOOLOS_ERRORS_PLATFORM_ALERTS=true
SCHOOLOS_SECURITY_HEADERS=true
SCHOOLOS_SECURITY_HSTS=false
SCHOOLOS_FORCE_HTTPS=false


# Phase 4 onboarding
# SCHOOLOS_TERMS_VERSION=2026-11
# SCHOOLOS_INVITATION_TTL_DAYS=7

# Phase 5 - academic and student management
SCHOOLOS_STUDENT_PREFIX=STU
SCHOOLOS_STUDENT_DOC_MAX_KB=5120
SCHOOLOS_STUDENT_DOC_DISK=local
SCHOOLOS_ATTENDANCE_EDIT_DAYS=1

# Phase 6 - external exams / records
SCHOOLOS_EXTERNAL_IMPORT_MAX_ROWS=5000
SCHOOLOS_EXTERNAL_IMPORT_MAX_KB=2048
SCHOOLOS_COLLECTION_REMINDER_DAYS=14
SCHOOLOS_COLLECTION_REMINDER_MAX=6
SCHOOLOS_RECORDS_DISK=local
SCHOOLOS_RECORDS_STAMP_MAX_KB=1024
SCHOOLOS_RECORDS_VERIFY_THROTTLE=60,1

# Phase 7 - LMS
SCHOOLOS_LMS_DISK=local
SCHOOLOS_LMS_FILE_MAX_KB=10240
SCHOOLOS_LMS_MAX_SUBMISSION_FILES=5
SCHOOLOS_LMS_INACTIVE_DAYS=14

# Phase 8 - SMS and internal messaging
# Mail (MAIL_*) and the SMS provider keys below are the SERVER DEFAULT. A platform administrator can instead enter them in
# the console (Platform -> Integrations): stored encrypted with APP_KEY (back it up), tested before they go live, and
# switching them off or removing them falls back to the values in this file.
# SMS driver: log (default, writes to the log, nothing is delivered) | null (off) | twilio | africastalking.
# A real driver is "Requires External Configuration": set its credentials, send a test SMS from Communications and
# confirm it arrives on a phone before telling schools SMS works. Each school also switches SMS on for itself.
# SCHOOLOS_SMS_DRIVER=log   (already set above)
SCHOOLOS_SMS_COUNTRY_CODE=220
SCHOOLOS_SMS_TIMEOUT=15
SCHOOLOS_SMS_MAX_ATTEMPTS=3
SCHOOLOS_SMS_DAILY_CAP=500
# Twilio: set the exact public URL of /webhooks/sms/twilio in TWILIO_STATUS_CALLBACK (it is part of the signature check).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_STATUS_CALLBACK=https://your-domain/webhooks/sms/twilio
# Africa's Talking: delivery reports go to /webhooks/sms/africastalking/{AT_WEBHOOK_SECRET} (use a long random secret).
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# AT_SANDBOX=false
# AT_WEBHOOK_SECRET=
# Internal messaging (private disk). Learners may answer but not start conversations unless this is true.
SCHOOLOS_MESSAGING_DISK=local
SCHOOLOS_MESSAGING_ATTACHMENT_KB=5120
SCHOOLOS_MESSAGING_MAX_ATTACHMENTS=3
SCHOOLOS_MESSAGING_STUDENTS_START=true
